# --- Core (required) ---
MONGODB_URI=mongodb://localhost:27017/geston-hosting
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173
PORT=5000
NODE_ENV=development

# --- Admin account ---
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Paystack (payments) ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_NIGERIA_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_NIGERIA_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_GHANA_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_GHANA_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SA_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SA_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Other payment providers ---
FAPSHI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
FAPSHI_API_USER=xxxxxxxxxxxxxxxxxxxxxxxx
SPEEDPESA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
WONYA_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
WONYA_PARTNER_ID=xxxxxxxxxxxxxxxxxxxxxxxx
WONYA_CALLBACK_URL=https://yourdomain.com/api/payments/wonya/callback
TXH_API=xxxxxxxxxxxxxxxxxxxxxxxx
TXH_API_URL=https://your-boosting-api.example.com/api

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=change-me
SMTP_FROM="Geston Hosting" <noreply@gestontech.online>

# --- Pterodactyl panel ---
PANEL_API_KEY=ptla_xxxxxxxxxxxxxxxxxxxxxxxx
PANEL_DOMAIN=https://panel.example.com
PANEL_EGG_ID=15
PANEL_NEST_ID=5
PANEL_EMAIL_DOMAIN=panel.example.com

# --- Heroku (bot deployment) ---
HEROKU_API_KEY=your-heroku-api-key-from-account-settings

# --- OAuth ---
GITHUB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- WhatsApp owner session ---
# BOT_OWNER_ID = a unique ID you choose to identify your own WhatsApp owner session in the database.
BOT_OWNER_ID=
PAIRING_URL=

# --- WhatsApp public bot ---
# DEV_WA_NUMBER = your personal WhatsApp number (digits only, country code included).
# Used for owner admin commands and Contact Developer cta_url. Do NOT use OWNER_NUMBER.
DEV_WA_NUMBER=243993030390
# T_NUMBERS = comma-separated WhatsApp numbers that get unrestricted AI (any topic).
# Still identifies as Geston Hosting assistant. Does NOT grant owner/admin powers.
# Example: 2547xxxxxxxx,2557xxxxxxxx
T_NUMBERS=
# DEV_NAME = the developer's display name, used in AI assistant replies.
DEV_NAME=Geston
# BRAND_NAME = the platform's display name, used in AI assistant replies.
BRAND_NAME=Geston Hosting
# WA_BOT_NUMBER = the public bot WhatsApp number (for landing page / docs links).
WA_BOT_NUMBER=

# --- AI assistant (Gemini primary, Groq fallback) ---
# Comma-separate multiple keys to rotate through when one hits a quota/rate
# limit, e.g. GEMINI_API_KEY=key1,key2,key3 — one key works fine too.
GEMINI_API_KEY=
GROQ_API_KEY=
# How long (hours) to keep per-user AI chat memory in RAM (default 6).
AI_MEMORY_TTL_HOURS=6

# Frontend (Vite) mirrors for Contact page links — optional
# Set these on Heroku BEFORE the build so Vite can bake them into the frontend.
VITE_DEV_WA_NUMBER=243993030390

# --- Site URLs ---
CLIENT_URL=https://hosting.gestontech.online
SITE_URL=https://hosting.gestontech.online
APP_URL=https://hosting.gestontech.online
IMAGE_URL=https://hosting.gestontech.online/logo/logo-full.png

# --- Pricing / limits ---
KSH_PER_TX=5
MONGO_STORAGE_QUOTA_MB=512
